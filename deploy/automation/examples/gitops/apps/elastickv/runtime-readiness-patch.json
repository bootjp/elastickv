[
  {
    "op": "add",
    "path": "/spec/template/spec/containers/0/args/-",
    "value": "--healthAddress=0.0.0.0:8081"
  },
  {
    "op": "add",
    "path": "/spec/template/spec/containers/0/ports/-",
    "value": {
      "name": "health",
      "containerPort": 8081
    }
  },
  {
    "op": "replace",
    "path": "/spec/template/spec/containers/0/startupProbe",
    "value": {
      "httpGet": {
        "path": "/livez",
        "port": "health"
      },
      "periodSeconds": 5,
      "timeoutSeconds": 2,
      "failureThreshold": 360
    }
  },
  {
    "op": "replace",
    "path": "/spec/template/spec/containers/0/livenessProbe",
    "value": {
      "httpGet": {
        "path": "/livez",
        "port": "health"
      },
      "periodSeconds": 5,
      "timeoutSeconds": 2,
      "failureThreshold": 3
    }
  },
  {
    "op": "replace",
    "path": "/spec/template/spec/containers/0/readinessProbe",
    "value": {
      "httpGet": {
        "path": "/readyz",
        "port": "health"
      },
      "periodSeconds": 5,
      "timeoutSeconds": 2,
      "failureThreshold": 3
    }
  }
]
