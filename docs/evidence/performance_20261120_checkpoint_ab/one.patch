+	group, probeCtx := errgroup.WithContext(ctx)
+	group.SetLimit(3)
+	for i, member := range members {
+		group.Go(func() error {
+			response, err := probeNamespacePeer(probeCtx, member, configuration, activated)
+			if err == nil {
+				responses[i] = response
+			}
+			return err
+		})
+	}
+	if err := group.Wait(); err != nil {
+		return nil, err
+	}
