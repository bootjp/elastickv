+package server
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"github.com/bootjp/elastickv/distribution"
+)
+
+// Bound both durable transitions using the times immediately before and after
+// local catalog reads. Keep foreground phase attribution at its usual 100 ms.
+type preflightTimeBounds struct {
+	lastBefore  time.Time
+	firstInside time.Time
+	lastInside  time.Time
+}
+
+func (b *preflightTimeBounds) sample(t *testing.T, catalog *distribution.CatalogStore, jobID uint64) bool {
+	start := time.Now()
+	job, found, err := catalog.SplitJob(t.Context(), jobID)
+	end := time.Now()
+	if err != nil || !found {
+		return false
+	}
+	switch {
+	case job.TransferPreflightDone:
+		if b.lastBefore.IsZero() || b.firstInside.IsZero() {
+			t.Errorf("missing observations bounding preflight for job %d", jobID)
+			return true
+		}
+		t.Logf("PERF preflight-duration lower_ms=%.3f upper_ms=%.3f",
+			float64(b.lastInside.Sub(b.firstInside).Microseconds())/1000,
+			float64(end.Sub(b.lastBefore).Microseconds())/1000)
+		return true
+	case job.Phase == distribution.SplitJobPhaseFence:
+		if b.firstInside.IsZero() {
+			b.firstInside = end
+		}
+		b.lastInside = start
+	default:
+		b.lastBefore = start
+	}
+	return false
+}
+
+func watchPerformancePreflight(t *testing.T, catalog *distribution.CatalogStore, jobID uint64) func() {
+	t.Helper()
+	if os.Getenv("ELASTICKV_PERF_PREFLIGHT_TIMING") != "1" {
+		return func() {}
+	}
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(10 * time.Millisecond)
+		defer ticker.Stop()
+		var bounds preflightTimeBounds
+		for !bounds.sample(t, catalog, jobID) {
+			select {
+			case <-ticker.C:
+			case <-stop:
+				// In witness-only runs the 100 ms waiter can observe the
+				// completion before the next 10 ms sample.
+				bounds.sample(t, catalog, jobID)
+				return
+			}
+		}
+	}()
+	return func() {
+		close(stop)
+		<-done
+	}
+}
